# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# Setup steps: docs/SHAREPOINT.md

[sharepoint]
enabled = true
tenant_id = ""            # Entra ID > Overview > Directory (tenant) ID
client_id = ""            # App registration > Application (client) ID
client_secret = ""        # App registration > Certificates & secrets
site_hostname = ""        # contoso.sharepoint.com
site_path = ""            # /sites/RTPS-QAP
bootstrap_admin_email = ""   # becomes Super Admin at first sign-in
# list_prefix = "RTPS_"
# documents_library = "RTPS Documents"
# reports_library = "RTPS Reports"
# pull_interval_seconds = 30

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""        # a long random string

[auth.microsoft]
client_id = ""
client_secret = ""
server_metadata_url = "https://login.microsoftonline.com/<tenant id>/v2.0/.well-known/openid-configuration"
